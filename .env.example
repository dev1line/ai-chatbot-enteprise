# ============================================================
# AI Chatbot Enterprise — ENV mẫu
# LOCAL-FIRST: mặc định chạy được local qua Docker, KHÔNG cần Azure.
# Azure (Phase 7) chỉ bật khi APP_ENV=staging|prod và đổi provider.
# ============================================================

# --- Run mode / flags ---
APP_ENV=local                 # local | docker | staging | prod
DEBUG=true

# --- Providers (swappable) ---
SECRETS_PROVIDER=env          # env | azure_key_vault
LLM_PROVIDER=mock             # mock | azure_openai   (local: mock)
EMBEDDING_PROVIDER=mock       # mock | azure_openai
VECTOR_DB_PROVIDER=memory     # memory | qdrant | milvus | pinecone

# --- Security ---
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (Postgres container) ---
DATABASE_URL=postgresql://app:app@postgres:5432/app

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Vector DB (Phase 2) ---
QDRANT_URL=http://qdrant:6333

# --- Azure (chỉ dùng ở staging/prod, Phase 7) ---
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT_CHAT=
AZURE_OPENAI_DEPLOYMENT_EMBED=

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
