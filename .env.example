# ============================================================
# AI Chatbot Enterprise — sample ENV
# LOCAL-FIRST: runs locally via Docker by default, Azure is NOT required.
# Azure (Phase 7) is only enabled when APP_ENV=staging|prod and the provider is changed.
# ============================================================

# --- Run mode / flags ---
APP_ENV=local                 # local | docker | staging | prod
DEBUG=true

# --- Providers (swappable) ---
SECRETS_PROVIDER=env          # env | azure_key_vault
LLM_PROVIDER=mock             # mock | azure_openai   (local: mock)
EMBEDDING_PROVIDER=local      # local | azure_openai
VECTOR_DB_PROVIDER=memory     # memory | qdrant | milvus | pinecone

# --- Security ---
JWT_SECRET=dev-secret-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Database (Postgres container) ---
DATABASE_URL=postgresql://app:app@postgres:5432/app

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Vector DB (Phase 2) ---
QDRANT_URL=http://qdrant:6333

# --- Azure OpenAI (Azure's OpenAI v1 format) ---
# To use a real model: set LLM_PROVIDER=azure_openai and fill in the values below.
# Do NOT commit real keys into the repo — only set them in .env (which is gitignored).
OPENAI_API_KEY=
OPENAI_BASE_URL=            # e.g. https://<resource>.openai.azure.com/openai/v1
OPENAI_API_TYPE=azure
OPENAI_API_VERSION=2024-02-01
MODEL_NAME=gpt-5-mini
MAX_CONTEXT_TOKENS=2048
COMPLETION_TOKEN_RESERVE=256
OPENAI_VERIFY_SSL=true
AZURE_EMBED_DEPLOYMENT=     # optional: embeddings deployment (e.g. text-embedding-ada-002)

# --- RAG ---
RAG_TOP_K=4
RAG_SCORE_THRESHOLD=0.0

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000
